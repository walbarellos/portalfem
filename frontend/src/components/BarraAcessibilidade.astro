---
/**
 * Links de Salto e Atalhos Globais de Acessibilidade
 * 
 * Este componente injeta links ocultos no topo da página (padrão WCAG)
 * para pular diretamente para o conteúdo principal, menu ou rodapé,
 * além de abrigar o script global de navegação por teclado (F e J).
 */
---

<nav aria-label="Links de salto" class="sr-only focus-within:not-sr-only focus-within:absolute focus-within:z-[9999] focus-within:bg-primary focus-within:text-white focus-within:p-4 focus-within:shadow-lg focus-within:rounded-br-lg">
  <div class="flex flex-col gap-2">
    <a href="#main-content" accesskey="j" class="hover:underline focus:underline focus:outline-none">
      Ir para o conteúdo principal <kbd class="ml-1 px-1 py-0.5 rounded bg-white/20 text-[10px] font-mono">Alt+J</kbd>
    </a>
    <a href="#main-nav" accesskey="g" class="hover:underline focus:underline focus:outline-none">
      Ir para o menu <kbd class="ml-1 px-1 py-0.5 rounded bg-white/20 text-[10px] font-mono">Alt+G</kbd>
    </a>
    <a href="#site-search" accesskey="h" class="hover:underline focus:underline focus:outline-none">
      Ir para a busca <kbd class="ml-1 px-1 py-0.5 rounded bg-white/20 text-[10px] font-mono">Alt+H</kbd>
    </a>
    <a href="#site-footer" accesskey="k" class="hover:underline focus:underline focus:outline-none">
      Ir para o rodapé <kbd class="ml-1 px-1 py-0.5 rounded bg-white/20 text-[10px] font-mono">Alt+K</kbd>
    </a>
  </div>
</nav>

<script>
  // Setup dos Skip Links e atalhos globais de acessibilidade
  
  // Navegação de salto (Skip links) via teclado global
  window.addEventListener('keydown', (e) => {
    if (e.altKey && !e.ctrlKey && !e.metaKey) {
      const key = e.key.toLowerCase();
      const targetMap: Record<string, string> = {
        'j': 'main-content',
        'g': 'main-nav',
        'h': 'site-search',
        'k': 'site-footer'
      };

      if (targetMap[key]) {
        e.preventDefault();
        const targetEl = document.getElementById(targetMap[key]);
        if (targetEl) {
          targetEl.focus();
          const isFixed = window.getComputedStyle(targetEl).position === 'fixed' || 
                          window.getComputedStyle(targetEl.parentElement || targetEl).position === 'fixed';
          if (!isFixed) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          
          // Se o leitor de voz estivesse ativo (removido)
        }
      }
    }

    // Navegação sequencial rápida (F e J)
    if (!e.altKey && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
      const key = e.key.toLowerCase();
      if (key === 'f' || key === 'j') {
        const active = document.activeElement as HTMLElement;
        const isInput = active && (
          active.tagName === 'INPUT' || 
          active.tagName === 'TEXTAREA' || 
          active.tagName === 'SELECT' || 
          active.isContentEditable
        );

        if (!isInput) {
          e.preventDefault();
          const selector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
          
          const mainContent = document.getElementById('main-content');
          const isOnBody = !active || active === document.body || active === document.documentElement || active === mainContent;
          
          const focusable = Array.from(document.querySelectorAll(selector))
            .map(el => el as HTMLElement)
            .filter(el => {
              return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
            });

          if (focusable.length > 0) {
            let currentIndex: number;
            
            if (isOnBody && mainContent) {
              const firstInMain = focusable.findIndex(el => mainContent.contains(el));
              if (key === 'j') {
                currentIndex = firstInMain >= 0 ? firstInMain : 0;
              } else {
                currentIndex = firstInMain > 0 ? firstInMain - 1 : focusable.length - 1;
              }
            } else {
              currentIndex = focusable.indexOf(active);
              if (key === 'j') {
                currentIndex = currentIndex >= 0 ? (currentIndex + 1) % focusable.length : 0;
              } else {
                currentIndex = currentIndex > 0 ? currentIndex - 1 : focusable.length - 1;
              }
            }
            
            const target = focusable[currentIndex];
            target.focus();
            target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            
            // Leitor de voz removido
          }
        }
      }
    }
  });

  // Garante que o foco seja movido programaticamente ao clicar nos links de salto
  const skipLinks = document.querySelectorAll('nav[aria-label="Links de salto"] a');
  skipLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const targetId = link.getAttribute('href')?.substring(1);
      if (!targetId) return;
      
      const targetEl = document.getElementById(targetId);
      if (targetEl) {
        e.preventDefault();
        e.stopPropagation();
        targetEl.focus();
        
        const isFixed = window.getComputedStyle(targetEl).position === 'fixed' || 
                        window.getComputedStyle(targetEl.parentElement || targetEl).position === 'fixed';
        
        if (!isFixed) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Leitor de voz removido
      }
    });
  });
</script>
